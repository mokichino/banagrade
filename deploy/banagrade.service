[Unit]
Description=Banagrade local grading service
# Edge device: grading starts at boot with or without Wi-Fi, so no network-online wait.

[Service]
Type=simple
User=banagrade
Group=banagrade
# Camera Module 3 (/dev/video*, /dev/media*) and the LED pins (/dev/gpiochip*).
SupplementaryGroups=video gpio
WorkingDirectory=/opt/banagrade/backend
EnvironmentFile=-/etc/banagrade/banagrade.env
# The camera preview is an endless MJPEG response, so an open System Status tab kept uvicorn
# "waiting for connections to close" until systemd killed it 90 s later, without releasing the
# camera or LEDs. After 5 s uvicorn cancels open responses and runs the app's shutdown.
ExecStart=/opt/banagrade/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 5
# Backstop in case closing the camera itself hangs.
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# Lets the service set the clock from a dashboard's time when there is no internet (backend/app/clock.py): with no
# RTC battery, a power cut leaves the clock behind. Nothing else needs root.
AmbientCapabilities=CAP_SYS_TIME
PrivateTmp=true

[Install]
WantedBy=multi-user.target