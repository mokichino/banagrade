BANAGRADE_DB=/var/lib/banagrade/banagrade.db
BANAGRADE_CORS_ORIGINS=http://banagrade.local
BANAGRADE_STAGE1_MODEL=/opt/banagrade/models/stage 1/stage1_best.pt
BANAGRADE_STAGE2_MODEL=/opt/banagrade/models/stage 2/stage2_best.pt
# Capture trigger. best.pt is the team's trained YOLO11n-presence (banana_bunch) and is the whole trigger.
# Pointing it at models/presence/yolo11n.pt instead uses the stock COCO model as a backup to Stage 2
# (BANAGRADE_PRESENCE_CONF applies to that mode only). Empty disables it: Stage 2 alone triggers.
BANAGRADE_PRESENCE_MODEL=/opt/banagrade/models/presence/best.pt
BANAGRADE_PRESENCE_CONF=0.50
# Thesis 4.4.3: horizontal bbox width in the 4608x2592 frame; >= threshold is Class A.
BANAGRADE_LENGTH_AXIS=width
BANAGRADE_WIDTH_THRESHOLD_PX=2730.07
BANAGRADE_STAGE1_MIN_CONF=0.80
# Stage 2 box confidence needed to grade. All held-out A/B bunches score >= 0.96; a hand on a desk scored 0.75.
BANAGRADE_STAGE2_MIN_CONF=0.90
# Not graded unless at least this share of the frame is clearly coloured; paper scored 0.014, bunches >= 0.19. 0 disables.
BANAGRADE_MIN_COLOUR_SHARE=0.05
# Lens position in dioptres, measured at the 45 cm rig height (docs/ON_SITE_TESTS.md §1), or "auto".
BANAGRADE_LENS_POSITION=0.99
# Seconds the table must look empty before a graded bunch is let go; shorter breaks (a hand, lifting it to turn it) do not rescan.
BANAGRADE_RELEASE_S=3
# Stock COCO YOLO11n checked just before capture: waits while a hand ("person" >= 0.30) is in view and refuses
# another COCO object (>= 0.40) on the bunch's box. Empty skips the check.
BANAGRADE_OBJECT_MODEL=/opt/banagrade/models/presence/yolo11n.pt
# HSV mask for Stage 1. Off: the trained model saw raw frames. Enable only for a model retrained on masked images.
BANAGRADE_STAGE1_MASK=0
BANAGRADE_HSV_LOWER=0,0,40
BANAGRADE_HSV_UPPER=179,255,255
BANAGRADE_MASK_KERNEL=7
# Fast-red error thresholds on the preview frame (lens covered / ring light off).
BANAGRADE_MIN_BRIGHTNESS=8
BANAGRADE_MIN_CONTRAST=1.5
# BCM pins: green = ready, yellow = Class A, blue = Class B, red = rejected/error.
BANAGRADE_LED_GREEN=17
BANAGRADE_LED_YELLOW=27
BANAGRADE_LED_BLUE=22
BANAGRADE_LED_RED=23
BANAGRADE_ENABLE_MODEL_INFERENCE=true
BANAGRADE_ENABLE_PIPELINE=true
# Disputed frames are copied here for retraining; must be writable by the service user.
BANAGRADE_RETRAIN_DIR=/var/lib/banagrade/retrain
# Every captured frame is archived so disputes have an image; ~0.9 MB each, oldest pruned. 0 disables.
BANAGRADE_FRAME_DIR=/var/lib/banagrade/frames
BANAGRADE_FRAME_KEEP=1000
# Drift indicators on System Status: latest N scans, and the scans an indicator needs before it judges.
BANAGRADE_DRIFT_WINDOW=200
BANAGRADE_DRIFT_MIN_SAMPLES=30
# Nightly backup (deploy/banagrade-backup.timer).
BANAGRADE_BACKUP_DIR=/var/lib/banagrade/backups
BANAGRADE_BACKUP_KEEP=14
# Physical LEDs are off until wired; the dashboard LED panel works either way.
BANAGRADE_ENABLE_GPIO=false
BANAGRADE_PRESENCE_INTERVAL_S=0.25
BANAGRADE_TORCH_THREADS=2
